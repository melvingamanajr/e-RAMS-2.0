{
  "name": "@erams/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0", "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0", "@nestjs/jwt": "^11.0.0",
    "@prisma/client": "^6.19.0", "argon2": "^0.44.0", "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1", "helmet": "^8.1.0", "ioredis": "^5.8.1",
    "pdfkit": "^0.17.2", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2",
    "socket.io": "^4.8.1", "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9", "@types/express": "^5.0.3", "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3", "prisma": "^6.19.0", "tsx": "^4.20.5", "typescript": "^5.9.2"
  }
}
