# Copy to .env only for Docker or an external PostgreSQL server.
# For the simplest local setup, leave .env absent and run npm run dev.
LOCAL_DATABASE=false
DATABASE_URL=postgresql://erams:REPLACE_DATABASE_PASSWORD@localhost:5432/erams
DATABASE_PASSWORD=REPLACE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BIOMETRIC_KEY=REPLACE_WITH_EXACTLY_64_HEXADECIMAL_CHARACTERS
AI_SERVICE_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AI_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:5173
PORT=3000
ADMIN_EMAIL=admin@erams.local
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
# Recognition is disabled by default because liveness is not implemented.
# Set true only for a supervised research demonstration, with suitable models.
ALLOW_UNVERIFIED_LIVENESS=false
