{
  "name": "erams",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @erams/api",
    "dev:web": "npm run dev -w @erams/web",
    "build": "npm run build -w @erams/api && npm run build -w @erams/web",
    "db:generate": "node scripts/database.mjs generate",
    "db:deploy": "node scripts/database.mjs deploy",
    "db:seed": "node scripts/database.mjs seed",
    "test": "npm run test -w @erams/api",
    "test:integration": "node scripts/integration.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^16.6.1",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
